# Copy to .env and adjust if you change ports or credentials.
KAFKA_BROKER=localhost:19092
POSTGRES_DSN=host=localhost port=5432 dbname=delivery user=delivery password=delivery
REDIS_HOST=localhost
REDIS_PORT=6379
SPARK_CHECKPOINT=/tmp/spark-order-counts-checkpoint

# UTC or "local"
TIMEZONE=UTC

# Producer tuning
ORDER_RATE=0.3
PINGS_PER_TICK=3
